<header class="about-header">
    <h1>BibliotecaMVC</h1>
    <p>
        Sistema web para la administración y consulta de información de bibliotecas.
    </p>
</header>

<section class="about-container">
    <article class="about-content">
        <h2>¿Quiénes somos?</h2>
        <p>
            BibliotecaMVC es un sistema desarrollado con ASP.NET Core MVC pensado
            para facilitar la gestión de un catálogo de biblioteca de forma digital.
            Permite administrar libros, autores, categorías y préstamos desde una
            interfaz sencilla y accesible para cualquier usuario.
        </p>
        <p>
            Este proyecto nace como parte del proceso de aprendizaje en el
            desarrollo de aplicaciones web utilizando el patrón Modelo-Vista-Controlador,
            aplicando buenas prácticas de diseño responsivo con HTML5, CSS3 y Bootstrap.
        </p>

        <h2>¿Qué ofrecemos?</h2>
        <div class="grid-servicios">
            @await Html.PartialAsync("_ServiceCard", new BibliotecaMVC.Models.ServiceCard { ImageUrl = "https://picsum.photos/200/201", Text = "Consulta rápida del catálogo de libros disponibles." })
            @await Html.PartialAsync("_ServiceCard", new BibliotecaMVC.Models.ServiceCard { ImageUrl = "https://picsum.photos/200/202", Text = "Registro y administración de autores." })
            @await Html.PartialAsync("_ServiceCard", new BibliotecaMVC.Models.ServiceCard { ImageUrl = "https://picsum.photos/200/203", Text = "Control de disponibilidad y préstamos." })
            @await Html.PartialAsync("_ServiceCard", new BibliotecaMVC.Models.ServiceCard { ImageUrl = "https://picsum.photos/200/204", Text = "Interfaz adaptable a computadoras, tablets y celulares." })
        </div>
    </article>

    <aside class="about-info info-flex">
        @await Html.PartialAsync("_InfoCard", new BibliotecaMVC.Models.InfoCard { Icono = "🎯", Titulo = "Misión", Descripcion = "Facilitar el acceso a la información bibliográfica mediante una plataforma digital moderna, ágil y fácil de usar para toda la comunidad estudiantil." })
        @await Html.PartialAsync("_InfoCard", new BibliotecaMVC.Models.InfoCard { Icono = "🔭", Titulo = "Visión", Descripcion = "Convertirnos en una herramienta de referencia para la gestión de bibliotecas digitales, integrando nuevas funcionalidades que mejoren la experiencia de lectura e investigación." })
    </aside>
</section>

<section class="team-section">
    <figure>
        <img src="https://picsum.photos/900/350" alt="Biblioteca" />
        <figcaption>Biblioteca virtual desarrollada con ASP.NET Core MVC</figcaption>
    </figure>
</section>