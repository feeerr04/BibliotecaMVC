@model BibliotecaMVC.Models.PaginaMensajeViewModel

@{
    var icono = Model.Icono switch
    {
        "lock" => "<rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/>",
        "search" => "<circle cx=\"11\" cy=\"11\" r=\"8\"/><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"/>",
        _ => "<path d=\"M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z\"/><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"/><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"/>"
    };
}

<div class="estado-pagina text-center">
    <div class="estado-icono estado-@Model.Color" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            @Html.Raw(icono)
        </svg>
    </div>

    @if (!string.IsNullOrEmpty(Model.Codigo))
    {
        <p class="estado-codigo estado-texto-@Model.Color">@Model.Codigo</p>
    }

    <h1 class="h2 fw-bold">@Model.Titulo</h1>
    <p class="lead text-muted mb-2">@Model.Mensaje</p>

    @if (!string.IsNullOrEmpty(Model.Detalle))
    {
        <p class="text-muted">@Model.Detalle</p>
    }

    <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
        <button type="button" class="btn btn-outline-secondary" onclick="history.back()">Regresar a la página anterior</button>
    </div>

    @if (!string.IsNullOrEmpty(Model.Referencia))
    {
        <p class="text-muted small mt-4 mb-0">Código de referencia: <code>@Model.Referencia</code></p>
    }
</div>
