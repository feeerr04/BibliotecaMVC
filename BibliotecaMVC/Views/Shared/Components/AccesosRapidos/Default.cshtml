@model List<(string Texto, string Controlador, string Accion)>

<div class="text-center mt-4">
    <p class="text-muted mb-2">Secciones disponibles para ti:</p>
    <div class="d-flex flex-wrap gap-2 justify-content-center">
        @foreach (var acceso in Model)
        {
            <a asp-controller="@acceso.Controlador" asp-action="@acceso.Accion" class="btn btn-outline-primary btn-sm">@acceso.Texto</a>
        }
    </div>
</div>
