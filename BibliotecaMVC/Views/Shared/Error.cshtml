@model ErrorViewModel
@using BibliotecaMVC.Models

@{
    var esNoEncontrado = Model.StatusCode == 404;
    ViewData["Title"] = esNoEncontrado ? "Página no encontrada" : "Ocurrió un problema";

    // Mensajes generales: nunca se muestran trazas, rutas internas ni cadenas de conexión.
    var vm = new PaginaMensajeViewModel
    {
        Icono = esNoEncontrado ? "search" : "error",
        Color = esNoEncontrado ? "warning" : "danger",
        Codigo = Model.StatusCode?.ToString() ?? "500",
        Titulo = esNoEncontrado ? "No encontramos lo que buscas" : "Algo salió mal",
        Mensaje = esNoEncontrado
            ? "El recurso solicitado no existe o fue eliminado."
            : "Ocurrió un problema inesperado al procesar tu solicitud. Ya fue registrado para su revisión.",
        Detalle = "Puedes volver al inicio o continuar navegando por las secciones disponibles.",
        Referencia = Model.ShowRequestId ? Model.RequestId : null
    };
}

<partial name="_PaginaMensaje" model="vm" />
@await Component.InvokeAsync("AccesosRapidos")
