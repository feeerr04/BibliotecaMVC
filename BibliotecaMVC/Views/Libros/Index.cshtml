@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Listado de Libros";
}

<h1>@ViewData["Title"]</h1>
<p>Hay @Model.Count() libros registrados.</p>

<a asp-action="Create" class="btn btn-primary mb-3">Nuevo libro +</a>

<div class="row">
    @foreach (var libro in Model)
    {
        <div class="col-md-4">
            <div class="card mb-3">
                <img src="~/images/libros/@libro.ImagenUrl" class="card-img-top" alt="@libro.Titulo" style="height: 250px; object-fit: cover;" />
                <div class="card-body">
                    <h5>@libro.Titulo</h5>
                    <h6>@libro.Autor</h6>
                    <p>@libro.Categoria - $@libro.Precio</p>

                    @if (libro.Disponible)
                    {
                        <span class="badge bg-success">Disponible</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Prestado</span>
                    }

                    <div class="mt-2">
                        <a asp-action="Details" asp-route-id="@libro.Id">Ver</a> |
                        <a asp-action="Edit" asp-route-id="@libro.Id">Editar</a> |
                        <a asp-action="Delete" asp-route-id="@libro.Id">Eliminar</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
