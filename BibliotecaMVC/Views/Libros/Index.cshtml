@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Listado de Libros";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo libro +</a>
</div>

<p class="text-muted">Hay @Model.Count() libro(s) registrado(s).</p>

<div class="row">
    @foreach (var libro in Model)
    {
        <div class="col-md-4">
            <div class="card mb-3 shadow-sm">
                <img src="~/images/libros/@libro.ImagenUrl" class="card-img-top" alt="@libro.Titulo" style="height: 250px; object-fit: cover;" />
                <div class="card-body">
                    <h5 class="card-title mb-1">@libro.Titulo</h5>
                    <h6 class="card-subtitle text-muted mb-2">@libro.Autor</h6>
                    <p class="mb-2">@libro.Categoria &middot; $@libro.Precio</p>

                    @if (libro.Disponible)
                    {
                        <span class="badge bg-success mb-2">Disponible</span>
                    }
                    else
                    {
                        <span class="badge bg-danger mb-2">Prestado</span>
                    }

                    <div class="d-flex gap-2 mt-2">
                        <a asp-action="Details" asp-route-id="@libro.Id" class="btn btn-outline-primary btn-sm">Detalles</a>
                        <a asp-action="Edit" asp-route-id="@libro.Id" class="btn btn-outline-secondary btn-sm">Editar</a>

                        <button type="button" class="btn btn-danger btn-sm btn-eliminar" data-id="@libro.Id" data-entidad="el libro">
                            Eliminar
                        </button>

                        <form id="form-eliminar-@libro.Id" asp-action="Delete" asp-route-id="@libro.Id" method="post" style="display:none;">
                            @Html.AntiForgeryToken()
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <p class="text-muted">Aún no hay libros registrados.</p>
}
