@model IEnumerable<BibliotecaMVC.Models.UsuarioRolViewModel>

@{
    ViewData["Title"] = "Administrar usuarios";
    var roles = (List<string>)ViewBag.Roles;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>
</div>

<p class="text-muted">Hay @Model.Count() usuario(s) registrado(s). Desde aquí puedes cambiar el rol de cada usuario.</p>

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Usuario</th>
            <th>Correo</th>
            <th>Rol actual</th>
            <th class="text-end">Cambiar rol</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model)
        {
            var colorRol = usuario.RolActual switch
            {
                "Admin" => "bg-danger",
                "Bibliotecario" => "bg-warning text-dark",
                "Usuario" => "bg-secondary",
                _ => "bg-light text-dark"
            };

            <tr>
                <td>
                    @usuario.UserName
                    @if (usuario.EsUsuarioActual)
                    {
                        <span class="badge bg-info text-dark ms-1">Tú</span>
                    }
                </td>
                <td>@usuario.Email</td>
                <td><span class="badge @colorRol">@usuario.RolActual</span></td>
                <td class="text-end">
                    @if (usuario.EsUsuarioActual)
                    {
                        <span class="text-muted small">No puedes cambiar tu propio rol</span>
                    }
                    else
                    {
                        <form asp-action="CambiarRol" method="post" class="d-inline-flex gap-2 justify-content-end">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@usuario.Id" />
                            <select name="nuevoRol" class="form-select form-select-sm" style="width: auto;">
                                @foreach (var rol in roles)
                                {
                                    <option value="@rol" selected="@(rol == usuario.RolActual)">@rol</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="text-muted small">
    Nota: el cambio de rol se aplica completamente cuando el usuario cierra sesión y vuelve a iniciarla.
</p>
